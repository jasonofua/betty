{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/grade",
      "dest": "api/grade.py"
    },
    {
      "src": "/api/rollover",
      "dest": "api/rollover.py"
    },
    {
      "src": "/api/soccer",
      "dest": "api/soccer.py"
    },
    {
      "src": "/api/baseball",
      "dest": "api/baseball.py"
    },
    {
      "src": "/",
      "dest": "public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}